{
    "swagger": "2.0",
    "info": {
        "description": "通达信行情 HTTP API。",
        "title": "TDX API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api",
    "paths": {
        "/codes": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "代码"
                ],
                "summary": "获取证券代码",
                "parameters": [
                    {
                        "enum": [
                            "stocks",
                            "etfs",
                            "indexes",
                            "all"
                        ],
                        "type": "string",
                        "description": "类型，默认 stocks",
                        "name": "type",
                        "in": "query"
                    },
                    {
                        "maximum": 5000,
                        "minimum": 1,
                        "type": "integer",
                        "description": "数量限制，默认 200，最大 5000",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "关键词，匹配代码、完整代码或名称",
                        "name": "keyword",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.ResponseDoc"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "系统"
                ],
                "summary": "健康检查",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.ResponseDoc"
                        }
                    }
                }
            }
        },
        "/kline": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "行情"
                ],
                "summary": "获取 K 线",
                "parameters": [
                    {
                        "type": "string",
                        "example": "000001",
                        "description": "股票代码",
                        "name": "code",
                        "in": "query",
                        "required": true
                    },
                    {
                        "enum": [
                            "minute",
                            "minute5",
                            "minute15",
                            "minute30",
                            "hour",
                            "day",
                            "week",
                            "month",
                            "quarter",
                            "year"
                        ],
                        "type": "string",
                        "description": "周期，默认 day",
                        "name": "type",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "simple",
                            "raw"
                        ],
                        "type": "string",
                        "description": "返回格式：simple/raw，默认 simple",
                        "name": "format",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "qfq",
                            "hfq",
                            "none"
                        ],
                        "type": "string",
                        "description": "复权：qfq/hfq/none，默认 qfq",
                        "name": "adjust",
                        "in": "query"
                    },
                    {
                        "minimum": 0,
                        "type": "integer",
                        "description": "起始偏移，默认 0",
                        "name": "start",
                        "in": "query"
                    },
                    {
                        "maximum": 800,
                        "minimum": 1,
                        "type": "integer",
                        "description": "数量，默认 200，最大 800",
                        "name": "count",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "开始日期，支持 20260701 或 2026-07-01",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "结束日期，支持 20260701 或 2026-07-01",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/handler.ResponseDoc"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/handler.SimpleKlineDoc"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/minute": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "行情"
                ],
                "summary": "获取分时数据",
                "parameters": [
                    {
                        "type": "string",
                        "example": "000001",
                        "description": "股票代码",
                        "name": "code",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "日期，支持 20260701 或 2026-07-01",
                        "name": "date",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "simple",
                            "raw"
                        ],
                        "type": "string",
                        "description": "返回格式：simple/raw，默认 simple",
                        "name": "format",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/handler.ResponseDoc"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/handler.SimpleMinuteDoc"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/quote": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "行情"
                ],
                "summary": "获取五档行情",
                "parameters": [
                    {
                        "type": "string",
                        "example": "000001,600519",
                        "description": "股票代码，多个用逗号分隔",
                        "name": "code",
                        "in": "query",
                        "required": true
                    },
                    {
                        "enum": [
                            "simple",
                            "raw"
                        ],
                        "type": "string",
                        "description": "返回格式：simple/raw，默认 simple",
                        "name": "format",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/handler.ResponseDoc"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/handler.SimpleQuoteDoc"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        },
        "/trade": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "行情"
                ],
                "summary": "获取分时成交",
                "parameters": [
                    {
                        "type": "string",
                        "example": "000001",
                        "description": "股票代码",
                        "name": "code",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "日期，支持 20260701 或 2026-07-01",
                        "name": "date",
                        "in": "query"
                    },
                    {
                        "minimum": 0,
                        "type": "integer",
                        "description": "起始偏移，默认 0",
                        "name": "start",
                        "in": "query"
                    },
                    {
                        "minimum": 1,
                        "type": "integer",
                        "description": "数量，默认 100",
                        "name": "count",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "simple",
                            "raw"
                        ],
                        "type": "string",
                        "description": "返回格式：simple/raw，默认 simple",
                        "name": "format",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/handler.ResponseDoc"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/handler.SimpleTradeDoc"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        }
    },
